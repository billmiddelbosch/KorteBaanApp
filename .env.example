# Base URL of the API. Locally the MSW mock backend answers /api, so leave this unset.
# In Amplify set it per branch from the KorteBaanApiStack outputs:
#   staging    → ApiUrlDev  (https://<api-id>.execute-api.eu-west-2.amazonaws.com/dev)
#   production → ApiUrlProd (https://<api-id>.execute-api.eu-west-2.amazonaws.com/prod)
VITE_API_BASE_URL=

# Set to false to disable the MSW mock backend in `npm run dev` and hit VITE_API_BASE_URL instead
VITE_USE_MOCKS=true

{
  "name": "kortebaan-lambda",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run bundle:health && npm run bundle:auth && npm run bundle:me && npm run bundle:friends && npm run bundle:aiConnection && npm run bundle:analysis && npm run bundle:analysisWorker && npm run bundle:aiInstruction && npm run bundle:koersdag && npm run bundle:koersdagWorker && npm run bundle:terugblik && npm run bundle:terugblikWorker && npm run bundle:kalenderSync && npm run bundle:kbIngest",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "bundle:health": "esbuild src/health.ts --bundle --platform=node --target=node22 --outfile=dist/health.js --external:@aws-sdk/*",
    "bundle:auth": "esbuild src/auth.ts --bundle --platform=node --target=node22 --outfile=dist/auth.js --external:@aws-sdk/*",
    "bundle:me": "esbuild src/me.ts --bundle --platform=node --target=node22 --outfile=dist/me.js --external:@aws-sdk/*",
    "bundle:friends": "esbuild src/friends.ts --bundle --platform=node --target=node22 --outfile=dist/friends.js --external:@aws-sdk/*",
    "bundle:aiConnection": "esbuild src/aiConnection.ts --bundle --platform=node --target=node22 --outfile=dist/aiConnection.js --external:@aws-sdk/*",
    "bundle:analysis": "esbuild src/analysis.ts --bundle --platform=node --target=node22 --outfile=dist/analysis.js --external:@aws-sdk/*",
    "bundle:analysisWorker": "esbuild src/analysisWorker.ts --bundle --platform=node --target=node22 --outfile=dist/analysisWorker.js --external:pg-native",
    "bundle:aiInstruction": "esbuild src/aiInstruction.ts --bundle --platform=node --target=node22 --outfile=dist/aiInstruction.js --external:@aws-sdk/*",
    "bundle:koersdag": "esbuild src/koersdag.ts --bundle --platform=node --target=node22 --outfile=dist/koersdag.js --external:@aws-sdk/*",
    "bundle:koersdagWorker": "esbuild src/koersdagWorker.ts --bundle --platform=node --target=node22 --outfile=dist/koersdagWorker.js --external:pg-native",
    "bundle:terugblik": "esbuild src/terugblik.ts --bundle --platform=node --target=node22 --outfile=dist/terugblik.js --external:pg-native",
    "bundle:terugblikWorker": "esbuild src/terugblikWorker.ts --bundle --platform=node --target=node22 --outfile=dist/terugblikWorker.js --external:pg-native",
    "bundle:kalenderSync": "esbuild src/kalenderSync.ts --bundle --platform=node --target=node22 --outfile=dist/kalenderSync.js --external:@aws-sdk/*",
    "bundle:kbIngest": "esbuild src/kbIngest.ts --bundle --platform=node --target=node22 --outfile=dist/kbIngest.js --external:pg-native",
    "create-owner": "esbuild scripts/create-owner.ts --bundle --platform=node --target=node22 --outfile=.scripts/create-owner.js --external:@aws-sdk/* && node .scripts/create-owner.js",
    "kb-migrate": "esbuild scripts/kb-migrate.ts --bundle --platform=node --target=node22 --outfile=.scripts/kb-migrate.js --external:pg-native && node .scripts/kb-migrate.js",
    "kb-backfill": "esbuild scripts/kb-backfill.ts --bundle --platform=node --target=node22 --outfile=.scripts/kb-backfill.js --external:pg-native && node .scripts/kb-backfill.js"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-sdk/dsql-signer": "^3.1141.0",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1"
  }
}

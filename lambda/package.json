{
  "name": "kortebaan-lambda",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run bundle:health && npm run bundle:auth && npm run bundle:me && npm run bundle:friends && npm run bundle:aiConnection",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "bundle:health": "esbuild src/health.ts --bundle --platform=node --target=node22 --outfile=dist/health.js --external:@aws-sdk/*",
    "bundle:auth": "esbuild src/auth.ts --bundle --platform=node --target=node22 --outfile=dist/auth.js --external:@aws-sdk/*",
    "bundle:me": "esbuild src/me.ts --bundle --platform=node --target=node22 --outfile=dist/me.js --external:@aws-sdk/*",
    "bundle:friends": "esbuild src/friends.ts --bundle --platform=node --target=node22 --outfile=dist/friends.js --external:@aws-sdk/*",
    "bundle:aiConnection": "esbuild src/aiConnection.ts --bundle --platform=node --target=node22 --outfile=dist/aiConnection.js --external:@aws-sdk/*",
    "create-owner": "esbuild scripts/create-owner.ts --bundle --platform=node --target=node22 --outfile=.scripts/create-owner.js --external:@aws-sdk/* && node .scripts/create-owner.js"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
